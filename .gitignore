# Xcode
xcuserdata/
*.xcuserstate
DerivedData/
build/

# macOS
.DS_Store

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
# Regenerated on every fastlane invocation, so committing it just means a
# modified file appears after every run. The lane docs live in the
# Fastfile's own `desc` lines, which is where they're read from anyway.
fastlane/README.md
*.ipa
*.dSYM.zip

# Bundler. Keep the existing policy of resolving current fastlane releases
# on each fresh CI setup. Local macOS installs keep their ignored lockfile;
# bundle update fastlane refreshes that resolution explicitly. Dependencies
# live outside the source checkout when using Scripts/fastlane-local.sh.
Gemfile.lock
.bundle/

# Signing material — belongs in GitHub secrets, never in the repo.
*.p12
*.p8
*.mobileprovision
*.cer
